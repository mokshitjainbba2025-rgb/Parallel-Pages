{
  "entities": {
    "Post": {
      "title": "Post",
      "description": "A blog post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "slug": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "coverImage": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "published"] },
        "publishedAt": { "type": "object", "description": "Firebase Timestamp" },
        "createdAt": { "type": "object", "description": "Firebase Timestamp" },
        "updatedAt": { "type": "object", "description": "Firebase Timestamp" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "category": { "type": "string" },
        "readingTime": { "type": "number" },
        "likesCount": { "type": "number" },
        "viewsCount": { "type": "number" },
        "commentsCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "seo": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "ogImage": { "type": "string" }
          }
        }
      },
      "required": ["title", "slug", "content", "authorId", "status"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global site settings",
      "type": "object",
      "properties": {
        "siteName": { "type": "string" },
        "siteDescription": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "accentColor": { "type": "string" },
        "fontSans": { "type": "string" },
        "fontSerif": { "type": "string" },
        "logoUrl": { "type": "string" },
        "navigation": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "href": { "type": "string" }
            }
          }
        },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string" },
            "linkedin": { "type": "string" },
            "twitter": { "type": "string" },
            "youtube": { "type": "string" }
          }
        },
        "authorName": { "type": "string" },
        "authorBio": { "type": "string" },
        "authorImage": { "type": "string" },
        "themeMode": { "type": "string", "enum": ["light", "dark", "system"] }
      }
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "writer", "reader"] },
        "createdAt": { "type": "object", "description": "Firebase Timestamp" }
      },
      "required": ["uid", "email", "role"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A comment on a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorId": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "object", "description": "Firebase Timestamp" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "parentCommentId": { "type": "string" },
        "isTeamReply": { "type": "boolean" }
      },
      "required": ["postId", "authorName", "authorId", "content", "status"]
    },
    "NewsletterSubscriber": {
      "title": "NewsletterSubscriber",
      "description": "A newsletter subscriber",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "subscribedAt": { "type": "object", "description": "Firebase Timestamp" }
      },
      "required": ["email"]
    },
    "Contributor": {
      "title": "Contributor",
      "description": "A guest contributor or author",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "bio": { "type": "string" },
        "image": { "type": "string" },
        "social": {
          "type": "object",
          "properties": {
            "twitter": { "type": "string" },
            "linkedin": { "type": "string" },
            "github": { "type": "string" },
            "website": { "type": "string" }
          }
        }
      },
      "required": ["name", "bio", "image"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "An individual analytics event (page view, session start, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["page_view", "session_ping"] },
        "path": { "type": "string" },
        "slug": { "type": "string" },
        "referrer": { "type": "string" },
        "visitorId": { "type": "string" },
        "sessionId": { "type": "string" },
        "timestamp": { "type": "object", "description": "Firebase Timestamp" },
        "userAgent": { "type": "string" }
      },
      "required": ["type", "path", "visitorId", "sessionId", "timestamp"]
    },
    "Like": {
      "title": "Like",
      "description": "A like record for a post",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "postId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "object", "description": "Firebase Timestamp" }
      },
      "required": ["postId", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Collection of blog posts"
    },
    "/settings/site": {
      "schema": "SiteSettings",
      "description": "Global site settings document"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles"
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Collection of comments"
    },
    "/subscribers/{subscriberId}": {
      "schema": "NewsletterSubscriber",
      "description": "Collection of newsletter subscribers"
    },
    "/contributors/{contributorId}": {
      "schema": "Contributor",
      "description": "Collection of guest contributors"
    },
    "/analytics/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Collection of raw analytics events"
    },
    "/likes/{likeId}": {
      "schema": "Like",
      "description": "Collection of post likes"
    }
  }
}
