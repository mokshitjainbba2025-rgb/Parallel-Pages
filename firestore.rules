rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "mokshit.jain.bba2025@atlasskilltech.university" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
      ); 
    }
    
    function isWriter() { 
      return isSignedIn() && (
        isAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "writer")
      );
    }
    
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function isValidAnalyticsEvent(data) {
      return data.type in ['page_view', 'session_ping'] &&
             data.path is string && data.path.size() < 1024 &&
             data.visitorId is string && data.visitorId.size() < 128 &&
             data.sessionId is string && data.sessionId.size() < 128 &&
             data.timestamp == request.time;
    }

    // --- 1. Analytics & Tracking ---
    match /analytics/{eventId} {
      allow create: if isValidAnalyticsEvent(incoming());
      allow read, update, delete: if isAdmin();
    }

    // --- 2. Subscribers ---
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, write: if isAdmin();
    }

    // --- 3. Posts & Content ---
    match /posts/{postId} {
      function isPublished() { return resource.data.status == 'published'; }
      function isAuthor() { return isSignedIn() && resource.data.authorId == request.auth.uid; }
      
      allow read: if isPublished() || isAdmin() || isAuthor();
      allow create: if isWriter();
      allow update: if isAdmin() || (isAuthor() && incoming().status != 'published');
      allow delete: if isAdmin();
    }

    // --- 4. User Profiles ---
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isSignedIn();
      allow update: if (isOwner(userId) && incoming().role == existing().role) || isAdmin();
    }

    // --- 5. Engagement (Comments, Likes) ---
    match /comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid);
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // --- 6. Utilities & Assets ---
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contributors/{contributorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    // --- 0. Global Safety Net (Terminal) ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
